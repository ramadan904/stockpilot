{
  "name": "stockpilot",
  "version": "0.1.0",
  "private": true,
  "description": "An AI autopilot for tokenized stock portfolios that can only trade inside an onchain mandate you set.",
  "license": "MIT",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "demo": "hardhat run scripts/demo.ts",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:robinhood-testnet": "hardhat run scripts/deploy.ts --network robinhoodTestnet",
    "deploy:arbitrum-sepolia": "hardhat run scripts/deploy.ts --network arbitrumSepolia",
    "pilot": "hardhat run agent/run.ts",
    "typecheck": "tsc --noEmit && tsc -p web",
    "abi": "hardhat compile && node scripts/export-abi.mjs",
    "web": "vite web",
    "web:build": "vite build web",
    "web:preview": "vite preview web"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^3.0.0",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^7.1.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "hardhat": "^2.29.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solc": "^0.8.28",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@openzeppelin/contracts": "^5.6.1",
    "viem": "^2.57.3",
    "zod": "^3.25.76"
  }
}
