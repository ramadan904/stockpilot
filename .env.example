# Copy to .env for docker compose (or export in your shell). Never commit .env.

# Which network in hardhat.config.ts: robinhoodTestnet, arbitrumSepolia, localhost.
NETWORK=robinhoodTestnet
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com/rpc
# ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc

# --- fleet pilot ---
# The pilot key: the address vault owners name as their pilot. It can only trade inside each vault's mandate.
PRIVATE_KEY=
# FACTORY=0x...            # defaults to deployments/<network>.json
# INTERVAL=60              # seconds between ticks
# MIN_FEE_BPS=0            # serve only vaults paying at least this fee to this pilot (and ask it in the marketplace)
# PILOT_NAME=StockPilot fleet   # list this pilot in the onchain marketplace at start-up
# PILOT_URI=https://...
# FEE_EVERY_HOURS=24
# WEBHOOK_URL=             # operator alerts: Slack, Discord or any JSON endpoint
# SUBSCRIPTIONS=/app/deployments/subscriptions.json   # owner-signed alert subscriptions
# RESEND_API_KEY=          # email alerts and digests
# ALERT_FROM=StockPilot <alerts@example.com>
# ANTHROPIC_API_KEY=       # Claude-written digests; a plain digest is sent without it

# --- price relayer (testnet mock feeds only) ---
# The deployer key: it owns the MockPriceFeeds.
RELAYER_PRIVATE_KEY=
# Prices come from Yahoo Finance (no key) unless PYTH_API_KEY is set; PRICE_SOURCE=yahoo|pyth to choose.
# PYTH_API_KEY=            # Pyth Hermes key (pyth.dourolabs.app/hermes)
# PYTH_IDS={"TSLA":"0x...","AAPL":"0x..."}   # skip the Hermes symbol search
# HERMES_URL=https://pyth.dourolabs.app/hermes
# YAHOO_URL=https://query1.finance.yahoo.com
# DEVIATION_BPS=20
# HEARTBEAT=1800

# Host ports for /health and /metrics.
# FLEET_PORT=8080
# RELAYER_PORT=8081

# --- web app (Vercel) ---
# ANTHROPIC_API_KEY=       # the strategist, reports and Ask your vault; offline fallbacks without it
# SIGNATURE_RELAY_KEY=     # submits owners' signed check-ins and pauses so they need no gas (testnet ETH only)
